# Email (Gmail: use App Password — not your normal password)
# Create at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=
EMAIL_TO=you@example.com
EMAIL_FROM="Job Radar <you@example.com>"

# Optional: public URL of the hosted web dashboard (used in email links)
WEB_DASHBOARD_URL=

# Jooble (Israel) — free key at https://il.jooble.org/api/about
# Lifetime free quota is limited (~500 requests) — use sparingly.
JOOBLE_API_KEY=
# JOOBLE_API_URL=https://il.jooble.org/api/YOUR_KEY

# Optional Adzuna (skipped if empty)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Google Sheets sync (RADAR + Claude tabs only — never Job Tracker)
# Sheet: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID
GOOGLE_SHEET_ID=YOUR_SHEET_ID
# Prefer one JSON secret (GitHub Actions: GOOGLE_SERVICE_ACCOUNT_JSON):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com",...}
# Or path to the downloaded key file locally:
# GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json
# Or split fields:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=radar-sheets@YOUR_PROJECT.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
